{
  "schemaVersion": 1,
  "id": "better-workspaces",
  "name": "Better Workspaces",
  "version": "2.0.0",
  "author": "LukasTrust",
  "license": "MIT",
  "description": "Workspace indicators showing a per-window app icon, plus a full-screen overview to drag windows between workspaces and save/restore whole workspace setups (with optional boot-time restore).",
  "kinds": [
    "bar-widget",
    "overlay",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "qml/Workspaces.qml",
    "overlay": "qml/Overlay.qml",
    "service": "qml/Service.qml"
  },
  "barWidget": {
    "displayName": "Better Workspaces",
    "description": "Workspace numbers plus per-window app icons",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "maxIcons": 5,
      "iconSize": 14,
      "minWorkspaces": 5,
      "hideEmpty": false,
      "groupApps": false,
      "gameIcons": true,
      "overviewEnabled": true,
      "setupTargetMode": "add",
      "focusAfterSetupDrop": true
    }
  }
}
